# Mission Control — environment template
# Copy to .env and fill in. Never commit .env.

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# --- Auth ---
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# --- Database ---
DATABASE_URL=postgresql://user:***@localhost:5432/mission_control

# --- AI text (DeepSeek, cheap) ---
# Shared DeepSeek key (same as GAPOS_LLM_API_KEY used across the portfolio).
# LLM_API_KEY is accepted as an alias.
GAPOS_LLM_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_DEV_MODE=1 returns a canned streaming draft when no key is set, so the
# full signup → campaign → AI draft → send flow works offline.

# --- AI images (Gemini 2.5 Flash Image / "Nano Banana" — only provider) ---
# DeepInfra FLUX was removed per owner direction; GOOGLE_API_KEY is required
# for image generation (Generate new look + hero lookbook assets).
GOOGLE_API_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Mission Control <hello@yourdomain.com>
# RESEND_DEV_MODE=1 sends nothing (synthetic message ids) when no API key is
# set, so the schedule → claim → send flow works fully offline.
# RESEND_DEV_MODE=

# --- Scheduled sends (cron+queue runner) ---
# Secret guarding GET /api/cron/send (send it as the x-cron-secret header).
# Generate with: openssl rand -base64 32
CRON_SECRET=
# Worker poll interval (ms) and per-tick batch size (npm run worker).
# SEND_QUEUE_POLL_MS=15000
# SEND_QUEUE_LIMIT=50

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
