# Mission Control — environment template
# Copy to .env and fill in. Never commit .env.

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# --- Auth ---
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# --- Database ---
DATABASE_URL=postgresql://user:pass@localhost:5432/mission_control

# --- AI ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Mission Control <hello@yourdomain.com>
# RESEND_DEV_MODE=1 sends nothing (synthetic message ids) when no API key is
# set, so the schedule → claim → send flow works fully offline.
# RESEND_DEV_MODE=

# --- Scheduled sends (cron+queue runner) ---
# Secret guarding GET /api/cron/send (send it as the x-cron-secret header).
# Generate with: openssl rand -base64 32
CRON_SECRET=
# Worker poll interval (ms) and per-tick batch size (npm run worker).
# SEND_QUEUE_POLL_MS=15000
# SEND_QUEUE_LIMIT=50

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
